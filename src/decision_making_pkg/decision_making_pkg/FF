import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, QoSHistoryPolicy, QoSDurabilityPolicy, QoSReliabilityPolicy
from rclpy.time import Time

from std_msgs.msg import String, Bool
from interfaces_pkg.msg import PathPlanningResult, DetectionArray, MotionCommand
from .lib import decision_making_func_lib as DMFL

#--- 설정 변수들 ---
SUB_DETECTION_TOPIC_NAME = "detections"
SUB_PATH_TOPIC_NAME = "path_planning_result"
SUB_TRAFFIC_LIGHT_TOPIC_NAME = "yolov8_traffic_light_info"
SUB_LIDAR_OBSTACLE_TOPIC_NAME = "lidar_obstacle_info"
PUB_TOPIC_NAME = "topic_control_signal"
TIMER_PERIOD = 0.1  # 10Hz, 제어 주기

class MotionPlanningNode(Node):
    def __init__(self):
        super().__init__('motion_planner_node')

        # QoS 설정
        self.qos_profile = QoSProfile(
            reliability=QoSReliabilityPolicy.RELIABLE,
            history=QoSHistoryPolicy.KEEP_LAST,
            durability=QoSDurabilityPolicy.VOLATILE,
            depth=1
        )

        # ==================== 제어 게인 (튜닝 포인트) ====================
        # 이 값들을 조정하여 주행 성능을 최적화해야 합니다.
        self.Kp = 0.25  # 횡방향 오차에 대한 비례 게인 (반응성)
        self.Kd = 0.25  # 횡방향 오차 변화에 대한 미분 게인 (안정성, 진동 억제)
        self.Kf = 2.0   # 경로 기울기(피드포워드)에 대한 게인 (코너 예측)
        # =================================================================

        # PD 제어를 위한 변수 초기화
        self.previous_error = 0.0
        self.last_time = self.get_clock().now()

        # 데이터 수신 변수 초기화
        self.detection_data = None
        self.path_data = None
        self.traffic_light_data = None
        self.lidar_data = None
        
        # 최종 명령 변수 초기화
        self.steering_command = 0.0
        self.left_speed_command = 0
        self.right_speed_command = 0

        # 서브스크라이버 설정
        self.detection_sub = self.create_subscription(DetectionArray, SUB_DETECTION_TOPIC_NAME, self.detection_callback, self.qos_profile)
        self.path_sub = self.create_subscription(PathPlanningResult, SUB_PATH_TOPIC_NAME, self.path_callback, self.qos_profile)
        self.traffic_light_sub = self.create_subscription(String, SUB_TRAFFIC_LIGHT_TOPIC_NAME, self.traffic_light_callback, self.qos_profile)
        self.lidar_sub = self.create_subscription(Bool, SUB_LIDAR_OBSTACLE_TOPIC_NAME, self.lidar_callback, self.qos_profile)

        # 퍼블리셔 설정
        self.publisher = self.create_publisher(MotionCommand, PUB_TOPIC_NAME, self.qos_profile)

        # 타이머 설정
        self.timer = self.create_timer(TIMER_PERIOD, self.timer_callback)
        self.get_logger().info("Hybrid Motion Planner Node (PD + Feedforward) is ready.")

    def detection_callback(self, msg: DetectionArray):
        self.detection_data = msg

    def path_callback(self, msg: PathPlanningResult):
        self.path_data = list(zip(msg.x_points, msg.y_points))
            
    def traffic_light_callback(self, msg: String):
        self.traffic_light_data = msg

    def lidar_callback(self, msg: Bool):
        self.lidar_data = msg
        
    def timer_callback(self):
        """주기적으로 제어 로직을 실행하고 최종 명령을 전송합니다."""
        
        # 비상 정지 조건 확인
        stop_by_lidar = self.lidar_data is not None and self.lidar_data.data is True
        stop_by_traffic_light = self.is_red_light_stop_condition()

        if stop_by_lidar or stop_by_traffic_light:
            # 정지 명령
            self.steering_command = 0.0
            self.left_speed_command = 0
            self.right_speed_command = 0
        else:
            # 주행 로직 실행
            self.execute_hybrid_control()

        # 최종 모션 명령 메시지 생성 및 퍼블리시
        motion_command_msg = MotionCommand()
        motion_command_msg.steering = int(self.steering_command) # 최종 값은 정수형으로 변환
        motion_command_msg.left_speed = self.left_speed_command
        motion_command_msg.right_speed = self.right_speed_command
        self.publisher.publish(motion_command_msg)
        
        self.get_logger().info(f"Steering: {self.steering_command:.2f}, Speed: {self.left_speed_command}")

    def is_red_light_stop_condition(self):
        """빨간불 정지 조건을 확인하는 함수"""
        if self.traffic_light_data is None or self.traffic_light_data.data != 'Red':
            return False
        
        if self.detection_data is None or not self.detection_data.detections:
            # 신호등은 빨간색이지만, 감지된 객체가 없으면 일단 주행 (안전상 주의 필요)
            return False

        for detection in self.detection_data.detections:
            if detection.class_name == 'traffic_light':
                y_max = int(detection.bbox.center.position.y + detection.bbox.size.y / 2)
                # 신호등의 y좌표가 특정 값(예: 150)보다 작으면 정지선 근처로 판단
                if y_max < 150:
                    return True
        return False

    def execute_hybrid_control(self):
        """PD 제어와 피드포워드 제어를 결합하여 조향각과 속도를 결정합니다."""
        if self.path_data is None or len(self.path_data) < 20:
            # 경로 데이터가 없으면 안전하게 정지
            self.steering_command = 0.0
            self.left_speed_command = 0
            self.right_speed_command = 0
            return

        # 1. 횡방향 오차 계산 (PD 제어용)
        look_ahead_point_idx = 15  # PD 제어를 위한 주시 지점 인덱스
        target_x = self.path_data[look_ahead_point_idx][0]
        center_x = 340  # 이미지의 중앙 x좌표 (카메라 설정에 따라 조정 필요)
        lateral_error = target_x - center_x

        # 2. 경로 기울기 계산 (피드포워드 제어용)
        # 경로의 끝부분을 사용하여 전체적인 곡률 예측
        target_slope = DMFL.calculate_slope_between_points(self.path_data[-10], self.path_data[-1])

        # 3. PD + Feedforward 제어 로직
        current_time = self.get_clock().now()
        dt = (current_time - self.last_time).nanoseconds / 1e9
        self.last_time = current_time

        if dt <= 0: # 시간 변화가 없으면 제어하지 않음
            return

        # 각 제어항 계산
        p_term = self.Kp * lateral_error
        d_term = self.Kd * (lateral_error - self.previous_error) / dt
        f_term = self.Kf * target_slope  # 슬로프를 피드포워드 항으로 사용

        # 최종 조향각 계산
        self.steering_command = p_term + d_term + f_term
        self.previous_error = lateral_error
        
        # 조향각 최대/최소 제한
        max_steer = 7.0
        self.steering_command = max(-max_steer, min(max_steer, self.steering_command))

        # 주행 속도 설정
        self.left_speed_command = 200
        self.right_speed_command = 200

def main(args=None):
    rclpy.init(args=args)
    node = MotionPlanningNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("Shutdown by user.")
    finally:
        # 종료 시 모터 정지 명령 전송
        stop_cmd = MotionCommand()
        stop_cmd.steering = 0
        stop_cmd.left_speed = 0
        stop_cmd.right_speed = 0
        node.publisher.publish(stop_cmd)
        
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
